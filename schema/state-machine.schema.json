{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/json-state-machine.schema.json",
  "title": "JSON State Machine",
  "type": "object",
  "required": ["id", "initial", "states"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "initial": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "metadata": { "type": "object" },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "type": "string", "minLength": 1 }, "params": { "type": "object" } }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "guards": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "description": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "entry": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "exit": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "final": { "type": "boolean" },
        "metadata": { "type": "object" },
        "on": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/transition" },
              { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } }
            ]
          }
        }
      }
    }
  }
}
