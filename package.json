{
  "name": "json-state-machine",
  "version": "0.1.0",
  "description": "A JSON-defined, strongly typed state machine runtime with pluggable actions, guards, visualization, and resource closure analysis.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./analysis": { "types": "./dist/analysis/index.d.ts", "import": "./dist/analysis/index.js" },
    "./visualization": { "types": "./dist/visualization.d.ts", "import": "./dist/visualization.js" },
    "./schema": "./schema/state-machine.schema.json"
  },
  "files": ["dist", "schema", "examples", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
