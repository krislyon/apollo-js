{
  "$schema": "../schema/state-machine.schema.json",
  "id": "access-control",
  "version": "1.0.0",
  "initial": "requested",
  "states": {
    "requested": {
      "on": {
        "APPROVE": {
          "target": "active",
          "guards": [{ "type": "hasRole", "params": { "role": "administrator" } }],
          "actions": ["recordApproval", "provideAccess"]
        },
        "REJECT": "closed"
      }
    },
    "active": {
      "on": {
        "REVOKE": { "target": "closed", "actions": ["removeAccess"] }
      }
    },
    "closed": { "final": true }
  }
}
